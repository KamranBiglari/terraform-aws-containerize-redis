# This file itself should use LF
.gitattributes text eol=lf

# Force LF line endings for shell scripts
*.sh text eol=lf

# Force LF for Python files
*.py text eol=lf

# Force LF for other text files
*.md text eol=lf
*.tf text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
